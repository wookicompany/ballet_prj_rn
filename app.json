{
  "expo": {
    "name": "마이발레",
    "slug": "ballet-prj-rn",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myballet",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wookicompany.myballet",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "www.myballet.co.kr": {
              "NSExceptionAllowsInsecureHTTPLoads": false
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSCameraUsageDescription": "발레 기록과 공연 리뷰 작성 시 사진을 촬영해 업로드할 수 있도록 카메라 접근 권한이 필요해요.",
        "NSPhotoLibraryUsageDescription": "발레 기록과 공연 리뷰 작성 시 앨범에서 사진을 선택해 업로드할 수 있도록 사진 보관함 접근 권한이 필요해요.",
        "NSPhotoLibraryAddUsageDescription": "앱에서 촬영한 사진을 기기에 저장할 수 있도록 사진 보관함 저장 권한이 필요해요.",
        "CFBundleLocalizations": ["ko", "en"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "kr.co.myballet.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "wookicompany",
          "project": "balletprj-rn"
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "발레 기록 작성 시 발레 바 운동에 대한 건강 데이터를 읽기 위해 권한이 필요해요.",
          "NSHealthUpdateUsageDescription": "발레 기록 작성 시 발레 바 운동에 대한 건강 데이터를 쓰기 위해 권한이 필요해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-ios.png",
          "imageWidth": 240,
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 220
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3059c7b8-3b92-4b00-8756-97efa6eb413d"
      }
    }
  }
}
