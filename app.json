{
  "expo": {
    "name": "마이발레",
    "slug": "ballet-prj-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myballet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wookicompany.myballet",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "www.myballet.co.kr": {
              "NSExceptionAllowsInsecureHTTPLoads": false
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSCameraUsageDescription": "사진을 촬영하려면 카메라 권한이 필요해요.",
        "NSPhotoLibraryUsageDescription": "사진을 선택해 업로드하려면 사진 보관함 권한이 필요해요.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 사진을 저장하려면 사진 보관함 권한이 필요해요.",
        "CFBundleLocalizations": ["ko", "en"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "kr.co.myballet.app"
    },
    "plugins": [
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3059c7b8-3b92-4b00-8756-97efa6eb413d"
      }
    }
  }
}
